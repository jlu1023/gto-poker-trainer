# Secrets: never commit (added 2026-06-07, pre-first-push gate)
.env
.env.*
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*

# build artifacts
/target
# python bytecode from the verifiers importing verifier_boards
__pycache__/
# Tauri desktop shell: its own target tree, npm tooling, generated schemas, and the
# provisioned sidecar binary (re-copied from target/release by provision-sidecar.ps1)
/desktop/src-tauri/target/
/desktop/node_modules/
/desktop/src-tauri/gen/
/desktop/src-tauri/binaries/
# matrix generation archives (rollback states; delete once srp-v2 settles)
/matrix.pre-rangefix/
/matrix.pre-srpv2/

# smoke / engine JSON output
/out

# viz export output: regenerable from the matrix via
# `cargo run --release -p gto-store --example export_viz`, so it is build output, not
# source. Tracked until 2026-09-15, when the exported set went stale (the frontend has
# read solved spots from the server's /api since Phase 3, not from these files).
/viz/public/data/

# solved-spot cache: machine-local and multi-GB; wholesale-ignored since
# 2026-06-07 (operator decision at the first-push gate). Previously the
# manifest.json index was tracked while the .bin trees were ignored; a
# tracked manifest indexes files absent from any clone, and build_matrix
# regenerates it, so the whole directory is ignored now.
/matrix/

# Phase 5 graded-decision store (personal data; covered by /matrix/ above,
# kept for documentation)
/matrix/history/

# per-session agent conventions: kept locally, untracked from 2026-09-15 (public-release
# prep). It is internal working instruction, not project documentation, and README.md now
# carries the parts a reader needs. Earlier revisions remain in history.
/CLAUDE.md

# standard caches / noise (added 2026-06-07)
.venv/
venv/
node_modules/
dist/
build/
.pytest_cache/
*.log
