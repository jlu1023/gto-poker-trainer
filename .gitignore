# smoke / engine JSON output
/out

# solved-spot cache: ignore the heavy serialized trees, keep the manifest tracked
/matrix/*.bin
/matrix/*.bin.zst
/matrix/*.summary.json

# Phase 5 graded-decision store (personal data, accumulates per ingestion)
/matrix/history/
