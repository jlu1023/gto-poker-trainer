{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTO Lab",
  "version": "0.1.0",
  "identifier": "lab.gto.desktop",
  "build": {
    "frontendDist": "../../viz/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../viz run dev",
    "beforeBuildCommand": "npm --prefix ../../viz run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GTO Lab",
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
